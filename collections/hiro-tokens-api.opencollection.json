        {
          "info": {
            "name": "Semi-Fungible Token Metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.hiro.so/metadata/v1/sft/:principal/:token_id",
            "params": [
              {
                "name": "locale",
                "value": "",
                "type": "query",
