            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query"
              },
              {
                "name": "symbol",
                "value": "",
                "type": "query"
              },
              {
                "name": "address",
                "value": "SP3K8BC0PPEVCV7NZ6QSRWPQ2JE9E5B6N3PA0KBR9",
                "type": "query",
                "description": "Stacks Address"
              },
              {
                "name": "valid_metadata_only",
                "value": "",
