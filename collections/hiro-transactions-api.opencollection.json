        {
          "info": {
            "name": "Broadcast raw transaction",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.hiro.so/v2/transactions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Broadcast raw transactions on the network. You can use the [@stacks/transactions](https://github.com/blockstack/stacks.js)\nproject to generate a raw transaction payload.\n\nThe node performs static validation checks on transactions before accepting them into the mempool, including:\n- Transaction format validation\n- Signature verification\n- Nonce checking\n- Fee validation\n- Size limits\n"
        },
