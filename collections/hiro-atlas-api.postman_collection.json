          "name": "Get attachment by hash",
          "request": {
            "name": "Get attachment by hash",
            "description": {
              "content": "Get an attachment by its hash. Attachments are content stored in the Atlas network.\n\nThe attachment hash is a 40-character hex string (SHA-1 hash).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "attachments",
                ":hash"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "hash",
                  "description": "(Required) Hex-encoded SHA-1 hash of the attachment (40 characters)"
                }
              ]
            },
            "header": [
