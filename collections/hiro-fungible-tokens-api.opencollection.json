{
  "opencollection": "1.0.0",
  "info": {
    "name": "Signer Metrics Accounts Fungible Tokens API",
    "version": "1.0.3"
  },
  "items": [
    {
      "info": {
        "name": "Fungible Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fungible token holders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.hiro.so/extended/v1/tokens/ft/:token/holders",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "max number of holders to fetch"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "index of first holder to fetch"
              },
              {
                "name": "token",
                "value": "",
                "type": "path",
                "description": "fungible token identifier"
              }
            ]
          },
          "docs": "Retrieves the list of Fungible Token holders for a given token ID. Specify `stx` for the `token` parameter to get the list of STX holders."
        }
      ]
    }
  ],
  "bundled": true
}