                "description": "Principal for the contract which owns the SIP-010 token"
              }
            ]
          },
          "docs": "Retrieves metadata for a SIP-010 Fungible Token"
        },
        {
          "info": {
            "name": "Non-Fungible Token Metadata",
            "type": "http"
