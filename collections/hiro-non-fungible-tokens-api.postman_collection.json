          "id": "152ea4b7-35cb-4f35-b8dc-735096c58650",
          "name": "Non-Fungible Token holdings",
          "request": {
            "name": "Non-Fungible Token holdings",
            "description": {
              "content": "Retrieves the list of Non-Fungible Tokens owned by the given principal (STX address or Smart Contract ID).\n        Results can be filtered by one or more asset identifiers and can include metadata about the transaction that made the principal own each token.\n\n        More information on Non-Fungible Tokens on the Stacks blockchain can be found [here](https://docs.stacks.co/build/create-tokens/creating-a-nft).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "extended",
                "v1",
                "tokens",
                "nft",
                "holdings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "principal",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "asset_identifiers",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "asset_identifiers",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "50",
                  "description": "max number of tokens to fetch"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "index of first tokens to fetch"
                },
                {
                  "disabled": false,
                  "key": "tx_metadata",
                  "value": "false",
                  "description": "(Required) whether or not to include the complete transaction metadata instead of just `tx_id`. Enabling this option can affect performance and response times."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
