          "id": "9630fde2-3c28-4ac5-8117-f0dda2c6b3cf",
          "name": "Add regtest BTC tokens to address",
          "request": {
            "name": "Add regtest BTC tokens to address",
            "description": {
              "content": "Add 0.01 BTC token to the specified regtest BTC address.\n\n        The endpoint returns the transaction ID, which you can use to view the transaction in a regtest Bitcoin block\n        explorer. The tokens are delivered once the transaction has been included in a block.\n\n        **Note:** This is a Bitcoin regtest-only endpoint. This endpoint will not work on the Bitcoin mainnet.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "extended",
                "v1",
                "faucets",
                "btc"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "address",
                  "value": "<string>",
                  "description": "A valid regtest BTC address"
                },
                {
                  "disabled": false,
                  "key": "large",
                  "value": "false",
                  "description": "Request a large amount of regtest BTC than the default"
                },
                {
                  "disabled": false,
                  "key": "xlarge",
                  "value": "false",
                  "description": "Request an extra large amount of regtest BTC than the default"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
