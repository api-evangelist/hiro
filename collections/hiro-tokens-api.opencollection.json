        {
          "info": {
            "name": "Search Tokens",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.hiro.so/metadata/v1/search",
            "params": [
              {
                "name": "contract",
                "value": "",
                "type": "query",
                "description": "Contract identifiers to search for. Format: PRINCIPAL or PRINCIPAL:TOKEN_NUMBER. Defaults token_number to 1 when omitted."
              },
              {
                "name": "locale",
                "value": "",
                "type": "query",
                "description": "Metadata localization to retrieve"
              }
            ]
          },
          "docs": "Retrieves metadata for multiple tokens in a single request. Accepts up to 50 contract identifiers."
        }
