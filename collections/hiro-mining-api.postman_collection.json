          "name": "Upload a Stacks block",
          "request": {
            "name": "Upload a Stacks block",
            "description": {
              "content": "Upload a Stacks block to the node for processing.\nThe block must be in binary format and associated with the given consensus hash.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "blocks",
                "upload",
                ":consensus_hash"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "consensus_hash",
                  "description": "(Required) Consensus hash (40 hex characters)"
                }
